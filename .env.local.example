# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Bypasses Row Level Security — server-side only. Never rename this to
# NEXT_PUBLIC_*, which would ship it to the browser.
#
# This app has NO authentication: every /api route uses this key, so every
# route is reachable by anyone who can reach the deployment. Restrict access at
# the hosting layer (e.g. Vercel password protection or an IP allowlist) if the
# deployment should not be public.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Ask (optional) ──────────────────────────────────────────────────────────
# Only needed for the /ask assistant tab.
OPENROUTER_API_KEY=
# Optional model override, e.g. google/gemini-2.5-flash
OPENROUTER_MODEL=
