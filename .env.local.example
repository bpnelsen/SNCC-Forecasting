# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Bypasses Row Level Security — server-side only. Never rename this to
# NEXT_PUBLIC_*, which would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Sign-up allowlist ───────────────────────────────────────────────────────
# Comma-separated email domains permitted to self-register via /signup.
# Leave EMPTY (or omit) to disable self-service sign-up entirely, so accounts
# can only be created by an admin in Supabase → Authentication → Users.
#
# NOTE: this only gates /api/auth/signup. The anon key is public, so you must
# ALSO switch off "Allow new users to sign up" in
# Supabase → Authentication → Sign In / Providers, or people can call
# Supabase's own signup endpoint directly and bypass this list.
SIGNUP_ALLOWED_DOMAINS=

# ─── Ask (optional) ──────────────────────────────────────────────────────────
# Only needed for the /ask assistant tab.
OPENROUTER_API_KEY=
# Optional model override, e.g. google/gemini-2.5-flash
OPENROUTER_MODEL=
