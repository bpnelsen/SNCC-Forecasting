# Copy to .env for local development (never commit .env)
# Get DATABASE_URL from: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Your Vercel frontend URL — set this in the Vercel backend project's environment variables
FRONTEND_URL=https://your-frontend.vercel.app
